# Shared security token used by backend -> model-service communication.
MODEL_SERVICE_TOKEN=replace-with-a-strong-random-token

# Hugging Face token for gated/private models (optional for public models).
HUGGING_FACE_HUB_TOKEN=

# Model selection and defaults.
MODEL_ID=stabilityai/sd-turbo
DEFAULT_MODEL_ALIAS=turbo
MODEL_DEVICE=cpu
MODEL_DEFAULT_WIDTH=512
MODEL_DEFAULT_HEIGHT=512
MODEL_DEFAULT_STEPS=4
MODEL_DEFAULT_GUIDANCE_SCALE=0.0
MODEL_LOAD_MAX_RETRIES=5
MODEL_LOAD_RETRY_DELAY_SEC=20

# Hugging Face network timeout tuning (seconds).
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=30

# Backend -> model-service request resilience.
MODEL_REQUEST_TIMEOUT_SEC=420
MODEL_MAX_RETRIES=3
MODEL_RETRY_DELAY_SEC=5
MODEL_HEALTH_TIMEOUT_SEC=5

# CORS for backend API.
CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80
